        "status": 200,
        "body": {
          "meta": { "status": 200, "code": "OK", "message": "OK", "isSuccess": true },
          "data": {
            "terms": { "kind": "TERMS", "agreed": true, "agreedVersion": "v2", "currentVersion": "v2", "currentDocumentUrl": null, "updatedAt": "2026-01-01T00:00:00.000Z", "reconsentRequired": false },
            "privacy": { "kind": "PRIVACY", "agreed": true, "agreedVersion": "v1", "currentVersion": "v1", "currentDocumentUrl": "https://shop.example.com/privacy", "updatedAt": null, "reconsentRequired": false },
            "marketing": { "kind": "MARKETING", "agreed": false, "agreedVersion": null, "currentVersion": null, "currentDocumentUrl": null, "updatedAt": "2026-10-20T00:00:00.000Z", "reconsentRequired": false },
            "reconsentRequired": false
          },
          "error": null
