            "market": { "marketId": "mkt_us", "currency": "USD", "matched": true },
            "locale": "en", "defaultLocale": "ko", "name": "데모 상점", "logoUrl": "https://cdn.example.test/logo.png",
            "customerCenterPhone": null, "businessHours": "10:00-18:00", "businessName": "데모", "representativeName": null,
            "guestCheckout": false, "loginMethods": ["google"], "checkoutAvailable": false, "checkoutMode": null,
            "checkoutUnavailableReason": "PAYMENT_NOT_LIVE"
          },
          "error": null
        }
      }
    },
    {
