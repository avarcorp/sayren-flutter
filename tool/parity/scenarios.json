            ]
          },
          "error": null
        }
      }
    },
    {
      "name": "catalog.listCollections 파라미터 생략",
      "call": "catalog.listCollections",
      "args": [],
      "response": {
        "status": 200,
        "body": {
          "meta": { "status": 200, "code": "OK", "message": "OK", "isSuccess": true },
          "data": { "page": 0, "size": 20, "totalElements": 0, "totalPages": 0, "contents": [] },
          "error": null
        }
