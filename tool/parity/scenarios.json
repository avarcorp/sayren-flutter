{
  "$comment": "같은 옵션·인자·서버 응답을 Node SDK와 Dart SDK에 넣고 요청과 결과를 비교한다. 옵션 값이 {\"$fn\": 값}이면 함수로 넘긴다.",
  "defaults": {
    "options": { "baseUrl": "https://api.example.test/storefront/v1", "storeCode": "demo" }
