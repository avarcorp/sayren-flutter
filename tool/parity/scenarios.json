      "args": [],
      "response": {
        "status": 200,
        "body": {
          "meta": { "status": 200, "code": "OK", "message": "OK", "isSuccess": true },
          "data": {
            "storeCode": "demo", "name": "데모 상점", "logoUrl": null, "customerCenterPhone": "02-000-0000",
            "businessHours": null, "guestCheckout": true, "loginMethods": ["password", "kakao"], "unknownField": 1
          },
          "error": null
        }
      }
    },
