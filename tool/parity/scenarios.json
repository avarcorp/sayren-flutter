        }
      }
    },
    {
      "name": "store.get 500 — 엔벨로프가 아닌 오류 본문",
      "call": "store.get",
      "args": [],
      "response": { "status": 500, "body": { "unexpected": true } }
    },
    {
      "name": "store.get 응답 계약 위반 — 필수 필드 누락·enum 밖 값",
      "call": "store.get",
      "args": [],
      "response": {
        "status": 200,
        "body": {
