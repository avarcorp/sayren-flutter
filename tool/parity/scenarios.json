      "options": { "auth": { "accessToken": "alias-token" } },
      "response": {
        "status": 401,
        "body": {
          "meta": { "status": 401, "code": "UNAUTHORIZED", "message": "로그인이 필요합니다", "isSuccess": false },
          "data": null,
          "error": { "code": "UNAUTHORIZED", "message": "로그인이 필요합니다", "docs": "not-a-url", "details": "not-a-record" }
        }
      }
